<div class="npc-builder">

  {{!-- ── Step: Info ──────────────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.info}} active{{/if}}" data-panel="info">
    <h3 class="npc-builder-panel-title">Character Info</h3>

    <div class="npc-builder-field-row">
      <label class="npc-builder-label">Name <span class="npc-required">*</span></label>
      <input class="npc-builder-input" type="text" name="supp-name" value="{{name}}"
        placeholder="Character Name" autofocus>
    </div>

    <div class="npc-builder-field-row">
      <label class="npc-builder-label">Character Type</label>
      <div class="npc-type-radios">
        <label class="npc-radio-label{{#if isSupporting}} active{{/if}}">
          <input type="radio" name="charType" value="supporting" {{#if isSupporting}}checked{{/if}}>
          Supporting
        </label>
        <label class="npc-radio-label{{#if isSupervisory}} active{{/if}}">
          <input type="radio" name="charType" value="supervisory" {{#if isSupervisory}}checked{{/if}}>
          Supervisory
        </label>
      </div>
    </div>

    <div class="npc-builder-field-row">
      <label class="npc-builder-label">
        Species <span class="npc-hint">(becomes a trait)</span>
      </label>
      {{#if speciesFromCatalog}}
      <div class="npc-species-combobox">
        <input class="npc-builder-input" type="text" name="species" value="{{species}}"
          placeholder="Search species…" autocomplete="off" role="combobox"
          aria-expanded="false" aria-autocomplete="list">
        <ul class="npc-species-dropdown" role="listbox">
          {{#each speciesList}}
          <li class="npc-species-option" role="option" data-value="{{name}}">
            {{name}}{{#if hasTalent}} <span class="npc-species-talent-badge" title="Has species talent">✦</span>{{/if}}
          </li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <input class="npc-builder-input" type="text" name="species" value="{{species}}"
        placeholder="e.g. Vulcan">
      {{/if}}
      <label class="npc-hybrid-toggle">
        <input type="checkbox" name="isHybrid" {{#if isHybrid}}checked{{/if}}>
        Hybrid
      </label>
    </div>

    {{#if isHybrid}}
    <div class="npc-builder-field-row">
      <label class="npc-builder-label">Second Species <span class="npc-hint">(becomes a trait)</span></label>
      {{#if speciesFromCatalog}}
      <div class="npc-species-combobox">
        <input class="npc-builder-input" type="text" name="hybridSpecies" value="{{hybridSpecies}}"
          placeholder="Search species…" autocomplete="off" role="combobox"
          aria-expanded="false" aria-autocomplete="list">
        <ul class="npc-species-dropdown" role="listbox">
          {{#each speciesList}}
          <li class="npc-species-option" role="option" data-value="{{name}}">{{name}}</li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <input class="npc-builder-input" type="text" name="hybridSpecies" value="{{hybridSpecies}}"
        placeholder="e.g. Human">
      {{/if}}
    </div>
    {{/if}}

    <div class="npc-builder-field-row">
      <label class="npc-builder-label">
        Purpose / Role <span class="npc-hint">(becomes a trait)</span>
      </label>
      <input class="npc-builder-input" type="text" name="purpose" value="{{purpose}}"
        placeholder="e.g. Starfleet Enlisted Crew">
    </div>

  </div>

  {{!-- ── Step: Attributes ──────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.attributes}} active{{/if}}" data-panel="attributes">
    <h3 class="npc-builder-panel-title">Assign Attributes</h3>
    <p class="npc-builder-hint">Drag numbers from the pool onto attribute rows. Drag a placed chip back to the pool to un-assign it.</p>

    <div class="npc-chip-pool{{#if attrPoolEmpty}} done{{/if}}" id="supp-attr-pool">
      {{#each availableAttrChips}}
      <div class="npc-chip" draggable="true" data-value="{{this}}" data-source-key="">{{this}}</div>
      {{/each}}
      {{#if attrPoolEmpty}}<span class="npc-pool-done"><i class="fa-solid fa-check"></i> All assigned</span>{{/if}}
    </div>

    {{#if showBonusColumn}}
    <p class="npc-builder-hint npc-bonus-hint">Species bonus:
      {{#if needsAttributeBonusSelection}}choose 3 attributes to receive <strong>+1</strong> each{{else}}attributes marked <strong>+1</strong> include your species bonus{{/if}}
    </p>
    {{/if}}

    <div class="npc-slot-grid{{#if showBonusColumn}} has-bonus-col{{/if}}">
      {{#each attributeSlots}}
      <div class="npc-slot-row">
        <span class="npc-slot-label">{{label}}</span>
        <div class="npc-drop-zone{{#unless value}} empty{{/unless}}" data-key="{{key}}">
          {{#if value}}
          <div class="npc-chip npc-chip--assigned" draggable="true"
            data-value="{{value}}" data-source-key="{{key}}">{{value}}</div>
          {{else}}
          <span class="npc-slot-placeholder">—</span>
          {{/if}}
        </div>
        {{#if ../showBonusColumn}}
        <div class="npc-bonus-col">
          {{#if fixedBonus}}
          <span class="npc-bonus-fixed">+1</span>
          {{else if choiceBonus}}
          <input type="checkbox" class="npc-bonus-attr-cb" value="{{key}}"
            {{#if choiceBonus.selected}}checked{{/if}}
            {{#if choiceBonus.disabled}}disabled{{/if}}>
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- ── Step: Departments ──────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.departments}} active{{/if}}" data-panel="departments">
    <h3 class="npc-builder-panel-title">Assign Departments</h3>
    <p class="npc-builder-hint">Assign all chips. Departments without a chip will default to 0.</p>

    <div class="npc-chip-pool{{#if discPoolEmpty}} done{{/if}}" id="supp-disc-pool">
      {{#each availableDiscChips}}
      <div class="npc-chip" draggable="true" data-value="{{this}}" data-source-key="">{{this}}</div>
      {{/each}}
      {{#if discPoolEmpty}}<span class="npc-pool-done"><i class="fa-solid fa-check"></i> All assigned</span>{{/if}}
    </div>

    <div class="npc-slot-grid">
      {{#each disciplineSlots}}
      <div class="npc-slot-row">
        <span class="npc-slot-label">{{label}}</span>
        <div class="npc-drop-zone{{#unless value}} empty{{/unless}}" data-key="{{key}}">
          {{#if value}}
          <div class="npc-chip npc-chip--assigned" draggable="true"
            data-value="{{value}}" data-source-key="{{key}}">{{value}}</div>
          {{else}}
          <span class="npc-slot-placeholder">0</span>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- ── Step: Focuses ──────────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.focuses}} active{{/if}}" data-panel="focuses">
    <h3 class="npc-builder-panel-title">Focuses{{#if isSupervisory}} &amp; Value{{/if}}</h3>

    <div class="npc-builder-section-label">
      Focuses <span class="npc-hint">(all required — at least one should relate to your purpose)</span>
    </div>
    {{#each focusList}}
    <div class="npc-builder-field-row">
      <div class="npc-field-rand-wrap">
        {{#if ../hasFocusSuggestions}}
        <div class="npc-focus-combobox npc-species-combobox">
          <input class="npc-builder-input" type="text" value="{{value}}"
            placeholder="Focus {{num}}" autocomplete="off">
          <ul class="npc-suggestion-dropdown npc-species-dropdown" role="listbox">
            {{#each ../focusSuggestions}}
            <li class="npc-suggestion-option npc-species-option" role="option">{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{else}}
        <input class="npc-builder-input npc-focus-input" type="text" value="{{value}}"
          placeholder="Focus {{num}}">
        {{/if}}
        <button class="npc-field-random-btn npc-builder-btn npc-builder-btn--ghost" type="button"
          title="Pick random" data-action="random-focus" data-index="{{@index}}"><i class="fa-solid fa-shuffle"></i></button>
      </div>
    </div>
    {{/each}}

    {{#if isSupervisory}}
    <div class="npc-builder-section-label npc-section-gap">
      Value <span class="npc-hint">(grants 1 Determination at first introduction)</span>
    </div>
    <div class="npc-builder-field-row">
      <div class="npc-field-rand-wrap">
        {{#if hasValueSuggestions}}
        <div class="npc-value-combobox npc-species-combobox">
          <input class="npc-builder-input" type="text" value="{{value}}"
            placeholder="e.g. Duty and Loyalty" autocomplete="off">
          <ul class="npc-suggestion-dropdown npc-species-dropdown" role="listbox">
            {{#each valueSuggestions}}
            <li class="npc-suggestion-option npc-species-option" role="option">{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{else}}
        <input class="npc-builder-input npc-value-input" type="text" value="{{value}}"
          placeholder="e.g. Duty and Loyalty">
        {{/if}}
        <button class="npc-field-random-btn npc-builder-btn npc-builder-btn--ghost" type="button"
          title="Pick random" data-action="random-value"><i class="fa-solid fa-shuffle"></i></button>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- ── Step: Talents ────────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.talents}} active{{/if}}" data-panel="talents">
    <h3 class="npc-builder-panel-title">Talents</h3>
    {{#if talentsAvailable}}
    <p class="npc-builder-hint">Choose talents from the configured compendiums.</p>
    <button class="npc-builder-btn npc-builder-btn--ghost" type="button" data-action="browse-talents">
      <i class="fa-solid fa-magnifying-glass"></i> Browse Talents...
    </button>
    {{else}}
    <p class="npc-builder-hint">No talent compendium configured. You can still add talents manually.</p>
    {{/if}}

    <div class="npc-builder-section-label npc-section-gap">Selected Talents</div>
    {{#if talents.length}}
    {{#each talents}}
    <article class="npc-custom-talent npc-custom-talent-item">
      <img class="npc-custom-talent-item__image" src="{{img}}" alt="">
      <div class="npc-custom-talent-item__body">
        <h4 class="npc-custom-talent-item__name">{{#if name}}{{name}}{{else}}Untitled Talent{{/if}}</h4>
        {{#if descriptionPreview}}
        <div class="npc-custom-talent-item__description">{{{descriptionPreview}}}</div>
        {{else}}
        <p class="npc-custom-talent-item__empty">No description.</p>
        {{/if}}
      </div>
      <div class="npc-custom-talent-item__controls">
        <button class="npc-builder-btn npc-builder-btn--ghost npc-custom-talent-edit" type="button"
          data-talent-index="{{@index}}" title="Edit talent" aria-label="Edit {{name}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button class="npc-builder-btn npc-builder-btn--ghost npc-custom-talent-remove" type="button"
          data-talent-index="{{@index}}" title="Remove talent" aria-label="Remove {{name}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </article>
    {{/each}}
    {{else}}
    <p class="npc-builder-hint">No talents selected.</p>
    {{/if}}

    <button class="npc-builder-btn npc-builder-btn--ghost npc-custom-talent-add" type="button">
      <i class="fa-solid fa-plus"></i> Add Custom Talent
    </button>
  </div>

  {{!-- ── Step: Finishing Up ────────────────────────────────────── --}}
  <div class="npc-builder-panel{{#if stepPanels.finishing}} active{{/if}}" data-panel="finishing">
    <h3 class="npc-builder-panel-title">Finishing Up</h3>

    <div class="npc-builder-section-label">
      Rank <span class="npc-hint">(supporting characters should not exceed Lieutenant)</span>
    </div>
    <div class="npc-builder-field-row">
      <select class="npc-builder-input" name="rank">
        <option value="">— No Rank —</option>
        {{#each rankGroups}}
        <optgroup label="{{label}}">
          {{#each ranks}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </div>

    <div class="npc-builder-section-label npc-section-gap">Equipment</div>
    <p class="npc-builder-hint">Add a ready-made loadout or browse for individual items.</p>
    {{#if equipmentLoadouts.length}}
    <div class="npc-loadout-presets">
      {{#each equipmentLoadouts}}
      <div class="npc-loadout-preset">
        <button class="npc-loadout-btn{{#if active}} active{{/if}}"
          data-loadout="{{@index}}" type="button">{{name}}</button>
        {{#if canDelete}}
        <button class="npc-loadout-delete" type="button"
          data-action="remove-equipment-preset" data-preset-index="{{customIndex}}"
          title="Delete {{name}}" aria-label="Delete equipment preset {{name}}">
          <i class="fa-solid fa-trash"></i>
        </button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{#if canSaveEquipmentPreset}}
    <button class="npc-builder-btn npc-builder-btn--ghost npc-equipment-save-preset"
      type="button" data-action="save-equipment-preset">
      <i class="fa-solid fa-bookmark"></i> Save Selection as Preset
    </button>
    {{/if}}
    <button class="npc-builder-btn npc-builder-btn--ghost npc-equipment-browse" type="button"
      data-action="browse-equipment">
      <i class="fa-solid fa-magnifying-glass"></i> Browse Equipment...
    </button>

    <div class="npc-builder-section-label npc-section-gap">Selected Equipment</div>
    {{#if selectedEquipmentItems.length}}
    <div class="npc-equipment-section">
      <ul class="npc-equip-list">
        {{#each selectedEquipmentItems}}
        <li class="npc-equip-item npc-selected-equipment-item">
          <div class="npc-equip-label">
            {{#if img}}<img class="npc-equip-img" src="{{img}}" alt="">{{/if}}
            <span class="npc-equip-name">{{name}}</span>
          </div>
          <button class="npc-builder-btn npc-builder-btn--ghost npc-selected-equipment-remove"
            type="button" data-action="remove-equipment" data-uuid="{{uuid}}"
            title="Remove equipment" aria-label="Remove {{name}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </li>
        {{/each}}
      </ul>
    </div>
    {{else}}
    <p class="npc-builder-hint">No equipment selected.</p>
    {{/if}}
  </div>

  {{!-- ── Footer ──────────────────────────────────────────────── --}}
  <div class="npc-builder-footer">
    <div class="npc-builder-footer-left">
      {{#unless isFirstStep}}
      <button class="npc-builder-back npc-builder-btn npc-builder-btn--ghost">
        <i class="fa-solid fa-chevron-left"></i> Back
      </button>
      {{/unless}}
      <button class="npc-builder-randomize npc-builder-btn npc-builder-btn--ghost" type="button"
        title="Randomize this step">
        <i class="fa-solid fa-shuffle"></i>
      </button>
    </div>

    <span class="npc-builder-step-label">{{stepLabel}}</span>

    <div class="npc-builder-footer-right">
      {{#if isLastStep}}
      <button class="supp-builder-create npc-builder-btn npc-builder-btn--primary"
        {{#unless canProceed}}disabled{{/unless}}>
        <i class="fa-solid fa-user-plus"></i> Create Character
      </button>
      {{else}}
      <button class="npc-builder-next npc-builder-btn npc-builder-btn--primary"
        {{#unless canProceed}}disabled{{/unless}}>
        Next <i class="fa-solid fa-chevron-right"></i>
      </button>
      {{/if}}
    </div>
  </div>

</div>
