<form class="sta-new-milestone-arc sta-ship-advancement-tabs" autocomplete="off">
  <nav class="tabs" role="tablist" data-group="primary">
    <a class="item active" role="tab" aria-selected="true" data-tab="milestone">{{milestoneTabTitle}}</a>
    <a class="item" role="tab" aria-selected="false" data-tab="arc">{{arcTabTitle}}</a>
  </nav>

  <section class="content">
    <div class="tab active" role="tabpanel" data-group="primary" data-tab="milestone">
      <p>{{milestonePrompt}}</p>
      <div class="sta-callbacks-vertical-footer sta-benefit-buttons">
        {{#each milestoneButtons}}
          <button type="button" class="dialog-button" data-action="{{action}}">{{label}}</button>
        {{/each}}
      </div>
    </div>

    <div class="tab" role="tabpanel" data-group="primary" data-tab="arc">
      <p>{{arcPrompt}}</p>
      <div class="sta-callbacks-vertical-footer sta-benefit-buttons">
        {{#each arcButtons}}
          <button type="button" class="dialog-button" data-action="{{action}}">{{label}}</button>
        {{/each}}
      </div>
    </div>
  </section>
</form>
