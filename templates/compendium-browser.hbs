<div class="sta-compendium-browser{{#if compact}} sta-compendium-browser--compact{{/if}}">
  {{#unless compact}}
  <aside class="sta-compendium-browser__sidebar">
    {{#each navigation as |group|}}
    <section class="sta-compendium-browser__group">
      <h2>{{group.label}}</h2>
      <nav aria-label="{{group.label}}">
        {{#each group.types as |type|}}
        <button
          type="button"
          class="sta-compendium-browser__type{{#if type.selected}} active{{/if}}"
          data-document-name="{{group.id}}"
          data-browser-type="{{type.id}}"
        >{{type.label}}</button>
        {{#if type.selected}}
        {{#if type.subcategories.length}}
        <div class="sta-compendium-browser__subcategories">
          {{#each type.subcategories as |category|}}
          <button
            type="button"
            class="sta-compendium-browser__subcategory{{#if category.selected}} active{{/if}}"
            data-character-category="{{category.id}}"
          >{{category.label}}</button>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}
        {{/each}}
      </nav>
    </section>
    {{/each}}
  </aside>
  {{/unless}}

  <section class="sta-compendium-browser__content">
    <header class="sta-compendium-browser__header">
      <div>
        <h1>{{selectedLabel}}</h1>
        <span>{{visibleCount}} / {{totalCount}} {{localize "sta-utils.compendiumBrowser.results"}}</span>
      </div>
      <label class="sta-compendium-browser__preset">
        <span>{{localize "sta-utils.compendiumBrowser.preset"}}</span>
        <select data-role="preset">
          <option value="">{{localize "sta-utils.compendiumBrowser.presets.custom"}}</option>
          {{#each presets as |preset|}}
          <option value="{{preset.id}}" {{#if preset.selected}}selected{{/if}}>{{preset.label}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" class="icon" data-action="refresh" data-tooltip aria-label="{{localize 'sta-utils.compendiumBrowser.refresh'}}">
        <i class="fa-solid fa-rotate"></i>
      </button>
      <button type="button" class="icon" data-action="settings" data-tooltip aria-label="{{localize 'sta-utils.compendiumBrowser.settings.title'}}">
        <i class="fa-solid fa-gear"></i>
      </button>
    </header>

    <div class="sta-compendium-browser__filters-shell">
      <div class="sta-compendium-browser__filters">
        <label>
          <span>{{localize "sta-utils.compendiumBrowser.search"}}</span>
          <input type="search" data-role="search" value="{{search}}" placeholder="{{localize 'sta-utils.compendiumBrowser.searchPlaceholder'}}" />
        </label>
        <label>
          <span>{{localize "sta-utils.compendiumBrowser.source"}}</span>
          <select data-role="source">
            {{#each sources as |source|}}
            <option value="{{source.id}}" {{#if source.selected}}selected{{/if}}>{{source.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#if isTalentView}}
        <label>
          <span>{{talentLabels.requirement}}</span>
          <select data-role="req-category">
            {{#each talentReqCategories as |cat|}}
            <option value="{{cat.id}}" {{#if cat.selected}}selected{{/if}}>{{cat.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>
          <span>{{talentLabels.requires}}</span>
          {{#if talentReqValueCombobox}}
          <input type="text" list="sta-compendium-browser-talent-values" data-role="req-value-text" value="{{talentReqValueText}}" placeholder="{{talentLabels.anyValue}}" autocomplete="off" />
          <datalist id="sta-compendium-browser-talent-values">
            {{#each talentReqValues as |val|}}
            {{#unless val.isAll}}<option value="{{val.label}}"></option>{{/unless}}
            {{/each}}
          </datalist>
          {{else}}
          <select data-role="req-value">
            {{#each talentReqValues as |val|}}
            <option value="{{val.id}}" {{#if val.selected}}selected{{/if}}>{{val.label}}</option>
            {{/each}}
          </select>
          {{/if}}
        </label>
        {{#if talentShowReqMin}}
        <label class="sta-talent-picker__min">
          <span>{{talentLabels.minimum}}</span>
          <input type="number" data-role="req-min" min="0" value="{{talentReqMin}}" placeholder="{{talentLabels.minimumPlaceholder}}" />
        </label>
        {{/if}}
        <button type="button" class="icon" data-action="reset-req" data-tooltip aria-label="{{talentLabels.resetRequirement}}">
          <i class="fa-solid fa-filter-circle-xmark"></i>
        </button>
        {{/if}}
        {{#if hasFieldFilters}}
        <button type="button" class="sta-compendium-browser__filter-toggle{{#if filtersExpanded}} active{{/if}}" data-action="toggle-filters">
          <i class="fa-solid fa-filter"></i> {{localize "sta-utils.compendiumBrowser.filters.title"}}
        </button>
        {{/if}}
      </div>
      {{#if filtersExpanded}}
      <div class="sta-compendium-browser__field-filters">
        {{#each fieldFilters as |filter|}}
        {{#if filter.isSelect}}
        <label>
          <span>{{filter.label}}</span>
          <select data-field-filter="{{filter.key}}" data-filter-slot="value">
            <option value="">{{localize "sta-utils.compendiumBrowser.filters.any"}}</option>
            {{#each filter.options as |option|}}
            <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        {{#if filter.isCombobox}}
        <label>
          <span>{{filter.label}}</span>
          <input type="text" list="{{filter.listId}}" data-field-filter="{{filter.key}}" data-filter-slot="value" value="{{filter.value}}" />
          <datalist id="{{filter.listId}}">
            {{#each filter.options as |option|}}
            <option value="{{option.value}}">{{option.label}}</option>
            {{/each}}
          </datalist>
        </label>
        {{/if}}
        {{#if filter.isRange}}
        <fieldset>
          <legend>{{filter.label}}</legend>
          <input type="number" data-field-filter="{{filter.key}}" data-filter-slot="min" value="{{filter.min}}" placeholder="{{localize 'sta-utils.compendiumBrowser.filters.min'}}" />
          <input type="number" data-field-filter="{{filter.key}}" data-filter-slot="max" value="{{filter.max}}" placeholder="{{localize 'sta-utils.compendiumBrowser.filters.max'}}" />
        </fieldset>
        {{/if}}
        {{/each}}
        <button type="button" class="icon" data-action="reset-field-filters" data-tooltip aria-label="{{localize 'sta-utils.compendiumBrowser.filters.reset'}}">
          <i class="fa-solid fa-filter-circle-xmark"></i>
        </button>
      </div>
      {{/if}}
    </div>

    <div class="sta-compendium-browser__table" style="--sta-browser-columns: {{gridTemplateColumns}};">
      <div class="sta-compendium-browser__row sta-compendium-browser__row--heading">
        {{#if isCharacterView}}<span aria-hidden="true"></span>{{/if}}
        <button type="button" class="sta-compendium-browser__cell--left" data-sort-key="name">{{localize "Name"}}</button>
        {{#if isTalentView}}
        <div class="sta-compendium-browser__cell--left">{{talentLabels.descriptionColumn}}</div>
        {{else}}
        {{#each columns as |column|}}
        <button type="button" class="sta-compendium-browser__cell--{{column.align}}" data-sort-key="{{column.key}}">{{column.label}}</button>
        {{/each}}
        {{/if}}
        {{#if showRollActions}}<span aria-hidden="true"></span>{{/if}}
      </div>
      <div class="sta-compendium-browser__rows">
        {{#if isTalentView}}
        {{#each records as |record|}}
        <article class="sta-compendium-browser__row sta-compendium-browser__row--talent" data-document-uuid="{{record.uuid}}" draggable="true" tabindex="0">
          <div class="sta-compendium-browser__name">
            <img src="{{record.img}}" alt="" loading="lazy" />
            <span class="sta-compendium-browser__name-text">
              <span class="sta-compendium-browser__name-title" title="{{record.name}}">{{record.name}}</span>
              <span class="sta-compendium-browser__name-subtype">{{record.talentTypeLabel}}</span>
            </span>
          </div>
          <div class="sta-compendium-browser__cell--left sta-compendium-browser__desc{{#if record.expanded}} is-expanded{{/if}}">
            {{#if record.hasRequirements}}
            {{#each record.requirementLines as |line|}}
            <span class="req">{{line.text}}</span>
            {{/each}}
            {{else}}
            <span class="req none">{{../talentLabels.noRequirements}}</span>
            {{/if}}
            <div class="desc-line">
              <span class="desc-body"><span class="text">{{record.descriptionText}}</span></span>
              {{#if record.showToggle}}
              <button type="button" class="desc-toggle" data-action="expand-description" data-uuid="{{record.uuid}}">{{#if record.expanded}}{{../talentLabels.showLess}}{{else}}{{../talentLabels.showMore}}{{/if}}</button>
              {{/if}}
            </div>
          </div>
        </article>
        {{/each}}
        {{else}}
        {{#each records as |record|}}
        <article class="sta-compendium-browser__row" data-document-uuid="{{record.uuid}}" draggable="true" tabindex="0">
          {{#if ../isCharacterView}}
          <span class="sta-compendium-browser__category-badge" style="color: {{record.categoryBadge.color}};" data-tooltip="{{record.categoryBadge.tooltip}}">
            <i class="{{record.categoryBadge.icon}}" aria-hidden="true"></i>
          </span>
          {{/if}}
          <div class="sta-compendium-browser__name"><img src="{{record.img}}" alt="" loading="lazy" /><span class="sta-compendium-browser__name-label" title="{{record.name}}">{{record.name}}</span></div>
          {{#each record.values as |cell|}}<span class="sta-compendium-browser__cell--{{cell.align}}">{{cell.value}}</span>{{/each}}
          {{#if record.canRoll}}
          <button type="button" class="sta-compendium-browser__roll" data-action="roll-table" data-roll-table-uuid="{{record.uuid}}" draggable="false" data-tooltip aria-label="{{localize 'sta-utils.compendiumBrowser.rollTable'}}">
            <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
            <span>{{localize "sta-utils.compendiumBrowser.rollTable"}}</span>
          </button>
          {{/if}}
        </article>
        {{/each}}
        {{/if}}
      </div>
    </div>

    {{#if loading}}
    <div class="sta-compendium-browser__state"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "sta-utils.compendiumBrowser.loading"}}</div>
    {{else unless hasRecords}}
    <div class="sta-compendium-browser__state">{{localize "sta-utils.compendiumBrowser.empty"}}</div>
    {{/if}}
    {{#if errors.length}}
    <div class="sta-compendium-browser__errors">{{localize "sta-utils.compendiumBrowser.packErrors"}}: {{errors}}</div>
    {{/if}}
  </section>
</div>